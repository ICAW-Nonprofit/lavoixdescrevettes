---
import { googleCalendarUrl } from '../lib/calendar';
import type { EventEntry } from '../lib/content';
import { url, ui, eventPath, formatDay, formatTime, type Lang } from '../i18n';

interface Props {
  events: EventEntry[];
  lang: Lang;
  /** zoom on a single event (event page) instead of showing France */
  single?: boolean;
  class?: string;
}
const { events, lang, single = false, class: cls = 'map' } = Astro.props;
const t = ui[lang];
const now = Date.now();
const data = events.map((e) => {
  const path = eventPath(e.id, lang);
  const page = new URL(url(path), Astro.site).href;
  return {
    title: e.data.title[lang],
    when: `${formatDay(e.data.start, lang)}, ${formatTime(e.data.start, lang)}`,
    where: `${e.data.venue.street}, ${e.data.venue.city}`,
    url: url(path),
    ics: url(`${path.replace(/\/$/, '')}.ics`),
    google: googleCalendarUrl(e, lang, page),
    lat: e.data.lat,
    lng: e.data.lng,
    past: e.data.end.getTime() < now,
  };
});
const labels = { details: t.details, ics: '.ics', google: 'Google' };
const fallback = lang === 'fr' ? 'Chargement de la carte…' : 'Loading map…';
---

<div class="map-wrap">
  <div class={cls} data-map data-events={JSON.stringify(data)} data-labels={JSON.stringify(labels)} data-single={String(single)} data-lang={lang} role="region" aria-label={lang === 'fr' ? 'Carte des actions' : 'Map of actions'}></div>
  <div class="map-fallback" aria-hidden="true">{fallback}</div>
</div>

<script>
  import '../scripts/map.js';
</script>
