---
import { site } from '../config';
import { route, url, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const f = t.footer;
const year = new Date().getFullYear();
const rss = lang === 'fr' ? '/rss.xml' : '/en/rss.xml';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-mark"><img src={url('/logo-bleu.svg')} alt="La Voix des Crevettes" width="875" height="655" loading="lazy" /></p>
      <p>{f.blurb}</p>
      <p>
        {f.with} <a href={site.icaw.url} rel="noopener" target="_blank">{site.icaw.name} ({site.icaw.short})</a>.
      </p>
    </div>
    <div>
      <h2>{f.site}</h2>
      <ul>
        <li><a href={url(route('agenda', lang))}>{t.nav.agenda}</a></li>
        <li><a href={url(route('report', lang))}>{t.nav.report}</a></li>
        <li><a href={url(route('blog', lang))}>{t.nav.blog}</a></li>
        <li><a href={url(route('resources', lang))}>{t.nav.resources}</a></li>
        <li><a href={url(route('about', lang))}>{t.nav.about}</a></li>
        <li><a href={url(route('contact', lang))}>{t.nav.contact}</a></li>
      </ul>
    </div>
    <div>
      <h2>{f.follow}</h2>
      <ul>
        <li><a href={site.instagram} rel="noopener" target="_blank">Instagram</a></li>
        <li><a href={site.newsletter.hostedPage} rel="noopener" target="_blank">Newsletter</a></li>
        <li><a href={site.icaw.url} rel="noopener" target="_blank">ICAW</a></li>
        <li><a href={url(rss)}>{f.rss}</a></li>
      </ul>
    </div>
    <div>
      <h2>{f.legal}</h2>
      <ul>
        <li><a href={url(route('legal', lang))}>{f.legalNotice}</a></li>
        <li><a href={url(route('privacy', lang))}>{f.privacy}</a></li>
        <li><button class="linkish" type="button" data-cookie-open>{f.cookies}</button></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} La Voix des Crevettes</span>
    <span>{lang === 'fr' ? 'Aucune crevette n’a été blessée pour faire ce site.' : 'No shrimp were harmed in the making of this site.'}</span>
  </div>
</footer>
