---
import { url } from '../i18n';

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
  label: string;
}
const { crumbs, label } = Astro.props;
---

<nav class="breadcrumbs" aria-label={label}>
  <ol>
    {crumbs.map((c, i) => (
      <li>{c.href && i < crumbs.length - 1 ? <a href={url(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>
